<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Inventarios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-3">
        <h2>SISTEMA DE INVENTARIO</h2>
        <div class="mb-2">
            <a asp-controller="Home" asp-action="Index">[Inicio]</a>
            <a asp-controller="Producto" asp-action="Index">[Productos]</a>
            <a asp-controller="Entrada" asp-action="Index">[Entradas]</a>
            <a asp-controller="Salida" asp-action="Index">[Salidas]</a>
        </div>
        <hr />

        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-info">
                @TempData["Mensaje"]
            </div>
        }

        @RenderBody()

        <hr />
        <footer class="text-muted small">
            <p>Sistema de Inventarios - Examen 1</p>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
