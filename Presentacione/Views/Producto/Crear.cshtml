@model Datos.DTOs.ProductoDTOS
@{
    ViewData["Title"] = "Registrar Producto";
}

<h3>Registrar Nuevo Producto</h3>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-2">
                <label>Código:</label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Nombre:</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Categoría:</label>
                <input asp-for="Categoria" class="form-control" />
                <span asp-validation-for="Categoria" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Precio:</label>
                <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Stock:</label>
                <input asp-for="Stock" type="number" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger small"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
            </div>
        </form>
    </div>
</div>
