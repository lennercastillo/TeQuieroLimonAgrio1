@model IEnumerable<Datos.DTOs.ProductoDTOS>
@{
    ViewData["Title"] = "Productos";
    var busqueda = ViewBag.BusquedaActual as string ?? "";
}

<h3>Productos</h3>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary btn-sm">Registrar Nuevo Producto</a>
</div>

<form method="get" asp-action="Index" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="buscar" value="@busqueda" class="form-control form-control-sm" placeholder="Buscar por código o nombre..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-secondary btn-sm">Buscar</button>
        @if (!string.IsNullOrEmpty(busqueda))
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
        }
    </div>
</form>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Categoria</td>
                    <td>@item.Precio</td>
                    <td>@item.Stock</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No hay productos encontrados.</td>
            </tr>
        }
    </tbody>
</table>
