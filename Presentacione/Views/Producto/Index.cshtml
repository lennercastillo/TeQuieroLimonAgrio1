@model IEnumerable<Datos.DTOs.ProductoDTOS>
@{
    ViewData["Title"] = "Productos";
    var busqueda = ViewBag.BusquedaActual as string ?? "";
}

<h2>Módulo de Productos</h2>
<p>Resumen de productos y existencias disponibles.</p>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="text" name="buscar" value="@busqueda" class="form-control" placeholder="Buscar por código o nombre..." />
            <button type="submit" class="btn btn-secondary">Buscar</button>
            @if (!string.IsNullOrEmpty(busqueda))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Crear" class="btn btn-primary">Registrar Nuevo Producto</a>
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Codigo</td>
                    <td>@item.Nombre</td>
                    <td>@item.Categoria</td>
                    <td>@item.Precio</td>
                    <td>@item.Stock</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No se encontraron productos.</td>
            </tr>
        }
    </tbody>
</table>
