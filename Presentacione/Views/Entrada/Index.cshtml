@model IEnumerable<Datos.DTOs.EntradaMercanciaDTOS>
@{
    ViewData["Title"] = "Entradas";
}

<h3>Entradas de Mercancía</h3>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary btn-sm">Registrar Entrada</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Código</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Proveedor</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaEntrada.ToShortDateString()</td>
                    <td>@item.CodigoProducto</td>
                    <td>@item.NombreProducto</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Proveedor</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No hay entradas registradas.</td>
            </tr>
        }
    </tbody>
</table>
