@model IEnumerable<Datos.DTOs.SalidaMercanciaDTOS>
@{
    ViewData["Title"] = "Salidas";
}

<h3>Salidas de Mercancía</h3>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-primary btn-sm">Registrar Salida</a>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Código</th>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Motivo</th>
            <th>Destino</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FechaSalida.ToShortDateString()</td>
                    <td>@item.CodigoProducto</td>
                    <td>@item.NombreProducto</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Motivo</td>
                    <td>@item.Destino</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No hay salidas registradas.</td>
            </tr>
        }
    </tbody>
</table>
