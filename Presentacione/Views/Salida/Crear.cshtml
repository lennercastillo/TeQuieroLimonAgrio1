@model Datos.DTOs.SalidaMercanciaDTOS
@{
    ViewData["Title"] = "Registrar Salida";
}

<h3>Registrar Salida de Mercancía</h3>

<div class="row">
    <div class="col-md-5">
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-2">
                <label>Producto:</label>
                <select asp-for="ProductoId" asp-items="ViewBag.Productos" class="form-select"></select>
                <span asp-validation-for="ProductoId" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Cantidad:</label>
                <input asp-for="Cantidad" type="number" min="1" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Motivo:</label>
                <input asp-for="Motivo" class="form-control" placeholder="Ej: Venta" />
                <span asp-validation-for="Motivo" class="text-danger small"></span>
            </div>

            <div class="mb-2">
                <label>Destino:</label>
                <input asp-for="Destino" class="form-control" placeholder="Ej: Mostrador" />
                <span asp-validation-for="Destino" class="text-danger small"></span>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary btn-sm">Volver</a>
            </div>
        </form>
    </div>
</div>
