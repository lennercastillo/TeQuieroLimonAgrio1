@model Datos.DTOs.SalidaMercanciaDTOS
@{
    ViewData["Title"] = "Registrar Salida";
}

<h2>Registrar Salida de Mercancía</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="ProductoId" class="form-label">Seleccionar Producto</label>
                <select asp-for="ProductoId" asp-items="ViewBag.Productos" class="form-select"></select>
                <span asp-validation-for="ProductoId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cantidad" class="form-label">Cantidad a Retirar</label>
                <input asp-for="Cantidad" type="number" min="1" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label">Motivo</label>
                <input asp-for="Motivo" class="form-control" placeholder="Ej: Venta" />
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Destino" class="form-label">Destino / Cliente</label>
                <input asp-for="Destino" class="form-control" placeholder="Ej: Cliente Mostrador" />
                <span asp-validation-for="Destino" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-danger">Guardar Salida</button>
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
        </form>
    </div>
</div>
