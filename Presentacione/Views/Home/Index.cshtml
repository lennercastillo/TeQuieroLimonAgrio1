@model Datos.DTOs.ResumenInventarioDTOS
@{
    ViewData["Title"] = "Inicio";
    var productos = ViewBag.UltimosProductos as List<Datos.DTOs.ProductoDTOS> ?? new List<Datos.DTOs.ProductoDTOS>();
}

<h3>Inicio</h3>
<p>Bienvenido al prototipo de sistema de inventario.</p>

<div class="mb-4">
    <p><strong>Resumen de Existencias:</strong></p>
    <ul>
        <li>Total de productos registrados: @Model.TotalProductos</li>
        <li>Total de existencias en almacén: @Model.TotalExistencias</li>
        <li>Total de entradas registradas: @Model.TotalEntradas</li>
        <li>Total de salidas registradas: @Model.TotalSalidas</li>
    </ul>
</div>

<h4>Resumen de Productos</h4>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Precio</th>
            <th>Stock</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in productos)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nombre</td>
                <td>@item.Precio</td>
                <td>@item.Stock</td>
            </tr>
        }
    </tbody>
</table>
